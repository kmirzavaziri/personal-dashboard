# ── Data (where the YAML lives) ───────────────────────────────────────────────
# In prod these point inside the cloned data repo; locally they default to ./db and ./storage.
DATA_DIR=/data
DB_ROOT=/data/db
STORAGE_ROOT=/data/storage

# ── Git-as-backup (durable, versioned data) ───────────────────────────────────
# Set DATA_REPO to enable: the app pulls on boot and pushes changes (debounced).
DATA_REPO=https://github.com/<you>/dashboard-data.git
DATA_REPO_TOKEN=            # GitHub token with write access to the data repo (clone + push)
GIT_BRANCH=main
GIT_BACKUP=                 # override; defaults to true when DATA_REPO is set
GIT_PUSH_DEBOUNCE=5         # seconds of quiet before a commit+push
GIT_AUTHOR_NAME=dashboard
GIT_AUTHOR_EMAIL=dashboard@localhost
WEBHOOK_SECRET=            # GitHub webhook secret → validates /api/webhook (out-of-band pulls)

# ── Access / identity ─────────────────────────────────────────────────────────
ALLOWED_EMAIL=you@example.com   # informational; Cloudflare Access enforces the real gate
MCP_TOKEN=                      # bearer token the MCP endpoint requires

# ── My Mac bridge (optional) ──────────────────────────────────────────────────
ENABLE_MAC=true            # false hides the Mac page entirely (friends who don't want it)
MAC_HOST=                  # your Mac's Tailscale name/IP; the server reaches it over the tailnet
# TS_AUTHKEY is provided to the container so it can join your tailnet (set as a deploy secret)

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
WEB_HOSTS=dashboard.example.com
